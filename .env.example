# Copy to web/.env.local for local dev. Set the same keys in Vercel. Never commit real values.

# --- Data ---
# Optional. "toy" (default) serves web/public/data/toy, "real" serves web/public/data (pipeline output).
NEXT_PUBLIC_DATA_SET=toy

# --- Supabase (reports, photo storage, admin login, live feed) ---
# Required for reports and admin. Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Required for reports and admin. Public anon key; safe in the browser, row-level security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required on the server only. Bypasses row-level security; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
# Optional. The one switch for every AI feature. Default "off": the site needs no key and shows a "paused" note
# where an AI feature would be. Set to "gemini" (with a key below) to turn photo reading, tailored text,
# Pelican's free-text understanding and the food search back on.
AI_PROVIDER=off
# Required only when AI_PROVIDER=gemini.
GEMINI_API_KEY=
# Optional. Primary and fallback model ids.
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# --- Weather ---
# Optional. User-Agent sent to api.weather.gov, which requires one. Use a generic app name.
NWS_USER_AGENT=fludd.app (hackathon demo)
